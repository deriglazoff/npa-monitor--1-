# Необязательный файл: скопируйте в .env рядом с программой, только если
# нужно переопределить встроенные настройки (по умолчанию всё ходит напрямую).

# RU-прокси. Нужен ТОЛЬКО для sozd.duma.gov.ru (гео-блок вне РФ).
# При запуске из России не нужен.
# PROXY_URL=http://ЛОГИН:ПАРОЛЬ@ХОСТ:ПОРТ

# Маршрут на источник: proxy | direct
SOZD_ROUTE=direct
CBR_ROUTE=direct
REGULATION_ROUTE=direct

HTTP_TIMEOUT=45
REQUEST_DELAY=1.0
MAX_RETRIES=3
