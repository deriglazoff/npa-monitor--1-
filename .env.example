# Скопируйте в .env и подставьте свои значения:  cp .env.example .env

# RU-прокси. Нужен ТОЛЬКО для sozd.duma.gov.ru (гео-блок вне РФ).
# При запуске из России не нужен — выставьте SOZD_ROUTE=direct.
PROXY_URL=http://ЛОГИН:ПАРОЛЬ@ХОСТ:ПОРТ

# Маршрут на источник: proxy | direct
SOZD_ROUTE=proxy
CBR_ROUTE=direct
REGULATION_ROUTE=direct

HTTP_TIMEOUT=45
REQUEST_DELAY=1.0
MAX_RETRIES=3
